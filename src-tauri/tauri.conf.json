{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "milch",
  "version": "../package.json",
  "identifier": "de.scheffbuch.milch",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Milch",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3NzM5REMzRTg5RTk0Q0UKUldUT2xKN293NTF6MTh5WStIUi80c1hVU0lLNGVGeWN6MHFqVDQzelBLUnVHd1JubGRNd0VWcFgK",
      "endpoints": [
        "https://github.com/bscheffbuch/milch/releases/latest/download/latest.json"
      ]
    }
  }
}
