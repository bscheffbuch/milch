{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Milch",
  "version": "../package.json",
  "identifier": "de.alp.milch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Milch — Alpabrechnung",
        "width": 1320,
        "height": 900,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Business",
    "shortDescription": "Alpabrechnung",
    "longDescription": "Milch, Messungen, Behandlungen und Käseabrechnung einer Alpsaison — alles in einer Datei auf dem eigenen Rechner.",
    "copyright": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": "de-DE"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3NzM5REMzRTg5RTk0Q0UKUldUT2xKN293NTF6MTh5WStIUi80c1hVU0lLNGVGeWN6MHFqVDQzelBLUnVHd1JubGRNd0VWcFgK",
      "endpoints": [
        "https://github.com/bscheffbuch/milch/releases/latest/download/latest.json"
      ]
    }
  }
}
